{
  "plugins": [
    { "id": "maquette", "label": "maquette", "hint": "Accepts .obj .stl .ply",
      "formats": [".obj", ".stl", ".ply"],
      "docs": "maquette-documentation.pdf",
      "typst": "https://typst.app/universe/package/maquette",
      "github": "https://github.com/bernsteining/maquette",
      "models": [
      ["bunny.obj",       "Bunny (OBJ)"],
      ["rubi_scan.ply",   "Rubik scan (PLY point cloud)"],
      ["teapot.obj",      "Teapot (OBJ)"],
      ["crankshaft.obj",  "Crankshaft (OBJ)"],
      ["brain_skull.obj", "Brain + skull (OBJ)"]
    ]},
    { "id": "scad", "label": "SCAD", "hint": "Accepts .scad · or edit inline in the browser",
      "formats": [".scad"],
      "docs": "maquette-scad-documentation.pdf",
      "typst": "https://typst.app/universe/package/maquette-scad",
      "github": "https://github.com/bernsteining/maquette",
      "models": [
      ["__scad__",        "OpenSCAD editor"],
      ["scad/gear.scad",  "Parametric gear"]
    ]},
    { "id": "gltf", "label": "glTF", "hint": "Accepts .glb .gltf",
      "formats": [".glb", ".gltf"],
      "docs": "maquette-gltf-documentation.pdf",
      "typst": "https://typst.app/universe/package/maquette-gltf",
      "github": "https://github.com/bernsteining/maquette",
      "models": [
      ["tokyo.glb",       "Littlest Tokyo (animated)"]
    ]},
    { "id": "molfig", "label": "molfig", "hint": "Accepts .pdb .cif .mmcif .bcif .xyz",
      "formats": [".pdb", ".cif", ".mmcif", ".bcif", ".xyz"],
      "docs": "https://github.com/rice8y/molfig/blob/v0.1.4/package/docs/documentation.pdf",
      "typst": "https://typst.app/universe/package/molfig",
      "github": "https://github.com/rice8y/molfig",
      "models": [
      ["caffeine",        "Caffeine"],
      ["aspirin",         "Aspirin"],
      ["crambin",         "Crambin (1CRN)"],
      ["9R1O",            "9R1O"]
    ]}
  ],
  "molecules": {
    "caffeine": { "src": "molecules/caffeine.pdb", "fmt": "pdb"  },
    "aspirin":  { "src": "molecules/aspirin.xyz",  "fmt": "xyz"  },
    "crambin":  { "src": "molecules/crambin.bcif", "fmt": "bcif" },
    "9R1O":     { "src": "molecules/9R1O.pdb",     "fmt": "pdb"  }
  },
  "defaults": {
    "bunny.obj": { "color": "#4488cc" },
    "__scad__": {
      "_cam": "spherical",
      "azimuth": 219, "elevation": 33, "fov": 40, "zoom": 1.2,
      "color": "#f9d72c", "specular": 0, "cull_backface": false,
      "scad_smooth_normals": true
    },
    "scad/gear.scad": {
      "_cam": "spherical",
      "azimuth": 219, "elevation": 33, "fov": 40, "zoom": 1.2,
      "color": "#f9d72c", "specular": 0, "cull_backface": false,
      "scad_smooth_normals": true
    },
    "brain_skull.obj": {
      "highlight": [["Skull", "#e8e8e8"], ["Brain", "#ee69b4"]],
      "mode": "x-ray", "xray_opacity": 0.3
    },
    "crankshaft.obj": {
      "_cam": "cartesian",
      "camera": [-100, -100, 500], "up": [0, -1, 0],
      "zoom": 1.25, "pan": [0, 0.08],
      "color": "#7d8590", "antialias": 4,
      "highlight": [
        ["Model__Crankshaft", { "color": "#cc0000", "stroke": "#ffffff", "stroke_width": 0.5 }],
        ["Model__Piston_A",   { "color": "#88ccff", "opacity": 0.3 }],
        ["Model__Piston_C",   { "color": "#88ccff", "opacity": 0.3 }],
        ["Model__Piston_D",   { "color": "#88ccff", "opacity": 0.3 }]
      ]
    },
    "rubi_scan.ply": {
      "point_size": 0.024, "point_boundary": 110,
      "_cam": "spherical", "azimuth": -119, "elevation": 24.5, "up": [0, 1, 0], "zoom": 2.254
    },
    "tokyo.glb": {
      "camera": [290, 464, 774], "center": [-86, 5, -25], "up": [0, 1, 0], "fov": 40,
      "background": "#182028"
    },
    "caffeine": {
      "_cam": "spherical", "azimuth": 30, "elevation": 25, "zoom": 1.3,
      "specular": 0.35, "shininess": 48,
      "mol_representation": "ball-and-stick", "mol_color_theme": "element-symbol",
      "mol_quality": "high", "mol_infer_bonds": true
    },
    "aspirin": {
      "_cam": "spherical", "azimuth": 30, "elevation": 25, "zoom": 1.3,
      "specular": 0.35, "shininess": 48,
      "mol_representation": "ball-and-stick", "mol_color_theme": "element-symbol",
      "mol_quality": "high", "mol_infer_bonds": true
    },
    "crambin": {
      "_cam": "spherical", "azimuth": 30, "elevation": 20, "zoom": 1.3,
      "specular": 0.25, "shininess": 32,
      "mol_representation": "cartoon", "mol_color_theme": "chain-id",
      "mol_quality": "high"
    },
    "9R1O": {
      "_cam": "spherical", "azimuth": 30, "elevation": 15, "zoom": 1.15,
      "specular": 0.2,
      "mol_representation": "cartoon", "mol_color_theme": "chain-id",
      "mol_quality": "medium"
    }
  }
}
